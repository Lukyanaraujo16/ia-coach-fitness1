{
  "name": "Badge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome do badge"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o de como conquistar"
    },
    "icon": {
      "type": "string",
      "description": "Nome do \u00edcone Lucide React"
    },
    "color": {
      "type": "string",
      "description": "Cor do badge (ex: blue, gold, purple)"
    },
    "category": {
      "type": "string",
      "enum": [
        "workout",
        "streak",
        "weight",
        "community",
        "special"
      ],
      "description": "Categoria do badge"
    },
    "requirement_type": {
      "type": "string",
      "enum": [
        "workout_count",
        "streak_days",
        "weight_lost",
        "posts_created",
        "likes_received",
        "special"
      ],
      "description": "Tipo de requisito"
    },
    "requirement_value": {
      "type": "number",
      "description": "Valor necess\u00e1rio para conquistar"
    },
    "xp_reward": {
      "type": "number",
      "description": "XP ganho ao conquistar o badge"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary"
      ],
      "default": "common",
      "description": "Raridade do badge"
    },
    "is_secret": {
      "type": "boolean",
      "default": false,
      "description": "Se o badge \u00e9 secreto (n\u00e3o aparece at\u00e9 conquistar)"
    }
  },
  "required": [
    "title",
    "category",
    "requirement_type"
  ]
}