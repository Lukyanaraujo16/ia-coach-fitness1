{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que abriu o chamado"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "subject": {
      "type": "string",
      "enum": [
        "support",
        "suggestion",
        "bug"
      ],
      "description": "Tipo do chamado: suporte, sugest\u00e3o ou bug"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo/resumo do chamado"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do problema/sugest\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "waiting_user",
        "closed"
      ],
      "default": "open",
      "description": "Status do chamado"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender_email": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_admin": {
            "type": "boolean"
          }
        }
      },
      "description": "Hist\u00f3rico de mensagens do chamado"
    },
    "last_interaction_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima intera\u00e7\u00e3o"
    },
    "has_unread_admin": {
      "type": "boolean",
      "default": false,
      "description": "Se tem mensagem n\u00e3o lida pelo admin"
    },
    "has_unread_user": {
      "type": "boolean",
      "default": false,
      "description": "Se tem mensagem n\u00e3o lida pelo usu\u00e1rio"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de fechamento do chamado"
    }
  },
  "required": [
    "user_email",
    "subject",
    "title",
    "description"
  ]
}