{
  "name": "FastingSettings",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "preferred_fasting_type": {
      "type": "string",
      "enum": [
        "14/10",
        "16/8",
        "18/6",
        "20/4",
        "24h",
        "custom"
      ],
      "default": "16/8",
      "description": "Tipo de jejum preferido"
    },
    "custom_fasting_hours": {
      "type": "number",
      "description": "Horas de jejum personalizado"
    },
    "custom_eating_hours": {
      "type": "number",
      "description": "Horas de alimenta\u00e7\u00e3o personalizado"
    },
    "auto_start_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Auto-iniciar jejum"
    },
    "auto_start_time": {
      "type": "string",
      "description": "Hor\u00e1rio para auto-iniciar (HH:MM)"
    },
    "reminder_start_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Lembrete para iniciar"
    },
    "reminder_end_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Lembrete para encerrar"
    },
    "streak_days": {
      "type": "number",
      "default": 0,
      "description": "Dias consecutivos de jejum"
    },
    "total_fasts": {
      "type": "number",
      "default": 0,
      "description": "Total de jejuns completados"
    },
    "total_hours_fasted": {
      "type": "number",
      "default": 0,
      "description": "Total de horas em jejum"
    }
  },
  "required": [
    "user_email"
  ]
}