{
  "name": "FastingLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "fasting_type": {
      "type": "string",
      "enum": [
        "14/10",
        "16/8",
        "18/6",
        "20/4",
        "24h",
        "custom"
      ],
      "description": "Tipo de jejum"
    },
    "fasting_hours": {
      "type": "number",
      "description": "Horas de jejum"
    },
    "eating_hours": {
      "type": "number",
      "description": "Horas de alimenta\u00e7\u00e3o"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio de in\u00edcio do jejum"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio de t\u00e9rmino do jejum"
    },
    "planned_end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio planejado para t\u00e9rmino"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "broken",
        "cancelled"
      ],
      "default": "active",
      "description": "Status do jejum"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o real em minutos"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "broken_reason": {
      "type": "string",
      "description": "Motivo de quebra do jejum"
    },
    "ai_tip": {
      "type": "string",
      "description": "Dica da IA ap\u00f3s o jejum"
    }
  },
  "required": [
    "user_email",
    "fasting_type",
    "start_time"
  ]
}